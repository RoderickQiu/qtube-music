            "value" : "歌单"
          }
        }
      }
    },
    "Plays or pauses the current song." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放或暂停当前歌曲。"
          }
        }
      }
    },
    "Previous Song" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上一首"
          }
        }
      }
    },
    "Returns the title and artist of what is playing." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
