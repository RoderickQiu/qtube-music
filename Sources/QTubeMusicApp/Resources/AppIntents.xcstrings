{
  "sourceLanguage" : "en",
  "strings" : {
    "Likes the song that’s playing: in your YouTube Music account when Sync is on, otherwise on this Mac." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喜欢正在播放的歌曲：开启同步时记入你的 YouTube Music 账户，否则只保存在这台 Mac 上。"
          }
        }
      }
    },
    "Get Current Song" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "获取当前歌曲"
          }
        }
      }
    },
    "Like Current Song" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喜欢当前歌曲"
          }
        }
      }
    },
    "Liked “%@”." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已喜欢“%@”。"
          }
        }
      }
    },
    "Next Song" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下一首"
          }
        }
      }
    },
    "Nothing is playing." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前没有播放。"
          }
        }
      }
    },
    "Sign in to YouTube Music in QTube Music to like songs." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先在 QTube Music 中登录 YouTube Music，才能喜欢歌曲。"
          }
        }
      }
    },
    "QTube Music is switching accounts. Try again in a moment." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QTube Music 正在切换账户，请稍后再试。"
          }
        }
      }
    },
    "QTube Music couldn’t like this song." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QTube Music 无法喜欢这首歌曲。"
          }
        }
      }
    },
    "Pause" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂停"
          }
        }
      }
    },
    "Play" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放"
          }
        }
      }
    },
    "Play ${playlist}" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放${playlist}"
          }
        }
      }
    },
    "Play Playlist" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放歌单"
          }
        }
